{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "/usr/share/nvim/runtime/lua",
      "${3rd}/luv/library",
      "${env:HOME}/.local/share/nvim/lazy/snacks.nvim/lua"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": ["vim"]
  },
    "diagnostics.disable": [
        "missing-fields",
        "unused-local"
    ]
}
